{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "neohubspaces.in" }],
      "destination": "https://www.neohubspaces.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "neohubspaces.in" }],
      "destination": "https://www.neohubspaces.in/:path*",
      "permanent": true
    }
  ]
}
