{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "neohubspaces.in" }],
      "destination": "https://www.neohubspaces.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "neohubspaces.in" }],
      "destination": "https://www.neohubspaces.in/:path*",
      "permanent": true
    },
    { "source": "/space-offerings", "destination": "/spaces", "permanent": true },
    { "source": "/space-offerings/", "destination": "/spaces", "permanent": true },
    { "source": "/home-1", "destination": "/", "permanent": true },
    { "source": "/home-1/", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about-us", "permanent": true },
    { "source": "/about/", "destination": "/about-us", "permanent": true },
    { "source": "/shop", "destination": "/spaces", "permanent": true },
    { "source": "/shop/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/product/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/product-category/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/product-tag/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/product-brand/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/category/:path*", "destination": "/blog", "permanent": true },
    { "source": "/workspace/coworking-space", "destination": "/hot-desk", "permanent": true },
    { "source": "/workspace/coworking-space/", "destination": "/hot-desk", "permanent": true },
    { "source": "/workspace/dedicated-desk", "destination": "/dedicated-desk", "permanent": true },
    { "source": "/workspace/dedicated-desk/", "destination": "/dedicated-desk", "permanent": true },
    { "source": "/workspace/meeting-rooms", "destination": "/meeting-rooms", "permanent": true },
    { "source": "/workspace/meeting-rooms/", "destination": "/meeting-rooms", "permanent": true },
    { "source": "/workspace/private-offices", "destination": "/private-cabins", "permanent": true },
    { "source": "/workspace/private-offices/", "destination": "/private-cabins", "permanent": true },
    { "source": "/workspace/:path*", "destination": "/spaces", "permanent": true },
    { "source": "/locations/monarch-tower", "destination": "/gomti-nagar", "permanent": true },
    { "source": "/locations/monarch-tower/", "destination": "/gomti-nagar", "permanent": true },
    { "source": "/all-locations", "destination": "/gomti-nagar", "permanent": true },
    { "source": "/all-locations/", "destination": "/gomti-nagar", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true }
  ]
}
